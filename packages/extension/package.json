{
  "name": "mermaid-animator",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "enbinario",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "sequence diagram",
    "animation",
    "diagram",
    "markdown"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121417",
    "theme": "dark"
  },
  "main": "./dist/extension.node.js",
  "browser": "./dist/extension.web.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onWebviewPanel:mermaidAnimator.panel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ]
      }
    ],
    "commands": [
      {
        "command": "mermaidAnimator.open",
        "title": "%command.open%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.openToSide",
        "title": "%command.openToSide%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.openAtCursor",
        "title": "%command.openAtCursor%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.animateAll",
        "title": "%command.animateAll%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.openFromExplorer",
        "title": "%command.openFromExplorer%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.openDiagram",
        "title": "%command.openDiagram%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export",
        "title": "%command.export%",
        "category": "Mermaid Animator",
        "icon": "$(export)"
      },
      {
        "command": "mermaidAnimator.exportDiagram",
        "title": "%command.exportDiagram%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.svg",
        "title": "%command.export.svg%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.png",
        "title": "%command.export.png%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.copyImage",
        "title": "%command.copyImage%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.togglePlay",
        "title": "%command.togglePlay%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.play",
        "title": "%command.play%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.pause",
        "title": "%command.pause%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.nextStep",
        "title": "%command.nextStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.previousStep",
        "title": "%command.previousStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.firstStep",
        "title": "%command.firstStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.lastStep",
        "title": "%command.lastStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.goToStep",
        "title": "%command.goToStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.revealSource",
        "title": "%command.revealSource%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.startPresentation",
        "title": "%command.startPresentation%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.stopPresentation",
        "title": "%command.stopPresentation%",
        "category": "Mermaid Animator",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mermaidAnimator.nextChapter",
        "title": "%command.nextChapter%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.previousChapter",
        "title": "%command.previousChapter%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.showTranscript",
        "title": "%command.showTranscript%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.toggleInspector",
        "title": "%command.toggleInspector%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.search",
        "title": "%command.search%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.insertAnnotation",
        "title": "%command.insertAnnotation%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.setView.sequence",
        "title": "%command.setView.sequence%",
        "category": "Mermaid Animator",
        "icon": "$(list-ordered)"
      },
      {
        "command": "mermaidAnimator.setView.topology",
        "title": "%command.setView.topology%",
        "category": "Mermaid Animator",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "mermaidAnimator.setView.split",
        "title": "%command.setView.split%",
        "category": "Mermaid Animator",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mermaidAnimator.toggleView",
        "title": "%command.toggleView%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.resetLayout",
        "title": "%command.resetLayout%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.copyStepLink",
        "title": "%command.copyStepLink%",
        "category": "Mermaid Animator",
        "icon": "$(link)"
      },
      {
        "command": "mermaidAnimator.saveLayout",
        "title": "%command.saveLayout%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.saveDefaults",
        "title": "%command.saveDefaults%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.gif",
        "title": "%command.export.gif%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.video",
        "title": "%command.export.video%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.animatedSvg",
        "title": "%command.export.animatedSvg%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.html",
        "title": "%command.export.html%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.diagramsView.refresh",
        "title": "%command.diagramsView.refresh%",
        "category": "Mermaid Animator",
        "icon": "$(refresh)"
      },
      {
        "command": "mermaidAnimator.diagramsView.filter",
        "title": "%command.diagramsView.filter%",
        "category": "Mermaid Animator",
        "icon": "$(filter)"
      },
      {
        "command": "mermaidAnimator.diagramsView.animate",
        "title": "%command.diagramsView.animate%",
        "category": "Mermaid Animator",
        "icon": "$(play)"
      },
      {
        "command": "mermaidAnimator.diagramsView.openSource",
        "title": "%command.diagramsView.openSource%",
        "category": "Mermaid Animator",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mermaidAnimator.diagramsView.export",
        "title": "%command.diagramsView.export%",
        "category": "Mermaid Animator",
        "icon": "$(export)"
      },
      {
        "command": "mermaidAnimator.walkthrough.openSample",
        "title": "%command.walkthrough.openSample%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.walkthrough.annotate",
        "title": "%command.walkthrough.annotate%",
        "category": "Mermaid Animator"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mermaidAnimator.open",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openToSide",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openAtCursor",
          "when": "mermaidAnimator.cursorInDiagram"
        },
        {
          "command": "mermaidAnimator.animateAll",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openFromExplorer",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.openDiagram",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.exportDiagram",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.export",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.export.svg",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.export.png",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.copyImage",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.togglePlay",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.play",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.pause",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.nextStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.previousStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.firstStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.lastStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.goToStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.revealSource",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.startPresentation",
          "when": "mermaidAnimator.panelActive && !mermaidAnimator.presenting"
        },
        {
          "command": "mermaidAnimator.stopPresentation",
          "when": "mermaidAnimator.presenting"
        },
        {
          "command": "mermaidAnimator.nextChapter",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.previousChapter",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.showTranscript",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.toggleInspector",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.search",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.insertAnnotation",
          "when": "mermaidAnimator.cursorInDiagram"
        },
        {
          "command": "mermaidAnimator.setView.sequence",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.setView.topology",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.setView.split",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.toggleView",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.resetLayout",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.copyStepLink",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.saveLayout",
          "when": "mermaidAnimator.panelActive && isWorkspaceTrusted"
        },
        {
          "command": "mermaidAnimator.saveDefaults",
          "when": "mermaidAnimator.panelActive && isWorkspaceTrusted"
        },
        {
          "command": "mermaidAnimator.export.gif",
          "when": "mermaidAnimator.panelActive || mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.export.video",
          "when": "mermaidAnimator.panelActive || mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.export.animatedSvg",
          "when": "mermaidAnimator.panelActive || mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.export.html",
          "when": "mermaidAnimator.panelActive || mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.diagramsView.filter",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.diagramsView.animate",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.diagramsView.openSource",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.diagramsView.export",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.walkthrough.annotate",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.diagramsView.refresh",
          "when": "config.mermaidAnimator.diagramsView.enabled"
        }
      ],
      "editor/title": [
        {
          "command": "mermaidAnimator.openToSide",
          "when": "mermaidAnimator.editorHasDiagram && !mermaidAnimator.panelActive",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidAnimator.openAtCursor",
          "when": "mermaidAnimator.cursorInDiagram",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "mermaidAnimator.openFromExplorer",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|mdx)$/i",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "mermaidAnimator.diagramsView.filter",
          "when": "view == mermaidAnimator.diagrams",
          "group": "navigation@1"
        },
        {
          "command": "mermaidAnimator.diagramsView.refresh",
          "when": "view == mermaidAnimator.diagrams",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mermaidAnimator.diagramsView.animate",
          "when": "view == mermaidAnimator.diagrams && viewItem == mermaidAnimator.diagram",
          "group": "inline"
        },
        {
          "command": "mermaidAnimator.diagramsView.animate",
          "when": "view == mermaidAnimator.diagrams && viewItem == mermaidAnimator.diagram",
          "group": "1_open@1"
        },
        {
          "command": "mermaidAnimator.diagramsView.openSource",
          "when": "view == mermaidAnimator.diagrams && viewItem == mermaidAnimator.diagram",
          "group": "1_open@2"
        },
        {
          "command": "mermaidAnimator.diagramsView.export",
          "when": "view == mermaidAnimator.diagrams && viewItem == mermaidAnimator.diagram",
          "group": "2_export@1"
        }
      ]
    },
    "configuration": {
      "title": "Mermaid Animator",
      "properties": {
        "mermaidAnimator.theme.mode": {
          "type": "string",
          "enum": [
            "auto",
            "ivory",
            "graphite",
            "highContrast"
          ],
          "enumDescriptions": [
            "%config.theme.mode.auto%",
            "%config.theme.mode.ivory%",
            "%config.theme.mode.graphite%",
            "%config.theme.mode.highContrast%"
          ],
          "default": "auto",
          "markdownDescription": "%config.theme.mode%"
        },
        "mermaidAnimator.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.enabled%"
        },
        "mermaidAnimator.files.languages": {
          "type": "array",
          "default": [
            "markdown",
            "mdx",
            "mermaid"
          ],
          "markdownDescription": "%config.files.languages%",
          "items": {
            "type": "string"
          }
        },
        "mermaidAnimator.liveReload.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.liveReload.enabled%"
        },
        "mermaidAnimator.liveReload.debounceMs": {
          "type": "number",
          "default": 250,
          "markdownDescription": "%config.liveReload.debounceMs%",
          "minimum": 0,
          "maximum": 5000
        },
        "mermaidAnimator.sync.stepToEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.sync.stepToEditor%"
        },
        "mermaidAnimator.sync.cursorToStep": {
          "type": "string",
          "default": "click",
          "markdownDescription": "%config.sync.cursorToStep%",
          "enum": [
            "off",
            "click",
            "follow"
          ],
          "enumDescriptions": [
            "%config.sync.cursorToStep.off%",
            "%config.sync.cursorToStep.click%",
            "%config.sync.cursorToStep.follow%"
          ]
        },
        "mermaidAnimator.playback.autoplay": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.playback.autoplay%"
        },
        "mermaidAnimator.playback.speed": {
          "type": "number",
          "default": 1,
          "markdownDescription": "%config.playback.speed%",
          "minimum": 0.25,
          "maximum": 4
        },
        "mermaidAnimator.playback.dwell": {
          "type": "string",
          "default": "adaptive",
          "markdownDescription": "%config.playback.dwell%",
          "enum": [
            "adaptive",
            "fixed"
          ],
          "enumDescriptions": [
            "%config.playback.dwell.adaptive%",
            "%config.playback.dwell.fixed%"
          ]
        },
        "mermaidAnimator.playback.dwellMs": {
          "type": "number",
          "default": 900,
          "markdownDescription": "%config.playback.dwellMs%",
          "minimum": 0
        },
        "mermaidAnimator.playback.onEnd": {
          "type": "string",
          "default": "stop",
          "markdownDescription": "%config.playback.onEnd%",
          "enum": [
            "stop",
            "loop",
            "rewind"
          ],
          "enumDescriptions": [
            "%config.playback.onEnd.stop%",
            "%config.playback.onEnd.loop%",
            "%config.playback.onEnd.rewind%"
          ]
        },
        "mermaidAnimator.playback.reverse": {
          "type": "string",
          "default": "animate",
          "markdownDescription": "%config.playback.reverse%",
          "enum": [
            "animate",
            "cut"
          ],
          "enumDescriptions": [
            "%config.playback.reverse.animate%",
            "%config.playback.reverse.cut%"
          ]
        },
        "mermaidAnimator.playback.pauseOnHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.playback.pauseOnHover%"
        },
        "mermaidAnimator.playback.startAt": {
          "type": "string",
          "default": "beginning",
          "markdownDescription": "%config.playback.startAt%",
          "enum": [
            "beginning",
            "end"
          ],
          "enumDescriptions": [
            "%config.playback.startAt.beginning%",
            "%config.playback.startAt.end%"
          ]
        },
        "mermaidAnimator.playback.notes": {
          "type": "string",
          "default": "step",
          "markdownDescription": "%config.playback.notes%",
          "enum": [
            "step",
            "attach",
            "hidden"
          ],
          "enumDescriptions": [
            "%config.playback.notes.step%",
            "%config.playback.notes.attach%",
            "%config.playback.notes.hidden%"
          ]
        },
        "mermaidAnimator.scrubber.snap": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.scrubber.snap%"
        },
        "mermaidAnimator.display.futureSteps": {
          "type": "string",
          "default": "hidden",
          "markdownDescription": "%config.display.futureSteps%",
          "enum": [
            "hidden",
            "ghosted",
            "visible"
          ],
          "enumDescriptions": [
            "%config.display.futureSteps.hidden%",
            "%config.display.futureSteps.ghosted%",
            "%config.display.futureSteps.visible%"
          ]
        },
        "mermaidAnimator.display.pastSteps": {
          "type": "string",
          "default": "full",
          "markdownDescription": "%config.display.pastSteps%",
          "enum": [
            "full",
            "muted",
            "trail"
          ],
          "enumDescriptions": [
            "%config.display.pastSteps.full%",
            "%config.display.pastSteps.muted%",
            "%config.display.pastSteps.trail%"
          ]
        },
        "mermaidAnimator.display.trailLength": {
          "type": "integer",
          "default": 3,
          "markdownDescription": "%config.display.trailLength%",
          "minimum": 1,
          "maximum": 20
        },
        "mermaidAnimator.motion.profile": {
          "type": "string",
          "default": "formal",
          "markdownDescription": "%config.motion.profile%",
          "enum": [
            "formal",
            "expressive",
            "minimal",
            "none"
          ],
          "enumDescriptions": [
            "%config.motion.profile.formal%",
            "%config.motion.profile.expressive%",
            "%config.motion.profile.minimal%",
            "%config.motion.profile.none%"
          ]
        },
        "mermaidAnimator.motion.respectReducedMotion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.motion.respectReducedMotion%"
        },
        "mermaidAnimator.motion.travelIndicator": {
          "type": "string",
          "default": "pulse",
          "markdownDescription": "%config.motion.travelIndicator%",
          "enum": [
            "pulse",
            "comet",
            "none"
          ],
          "enumDescriptions": [
            "%config.motion.travelIndicator.pulse%",
            "%config.motion.travelIndicator.comet%",
            "%config.motion.travelIndicator.none%"
          ]
        },
        "mermaidAnimator.camera.mode": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "%config.camera.mode%",
          "enum": [
            "auto",
            "fit",
            "follow",
            "cinematic",
            "manual"
          ],
          "enumDescriptions": [
            "%config.camera.mode.auto%",
            "%config.camera.mode.fit%",
            "%config.camera.mode.follow%",
            "%config.camera.mode.cinematic%",
            "%config.camera.mode.manual%"
          ]
        },
        "mermaidAnimator.playback.loopIterations": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "%config.playback.loopIterations%"
        },
        "mermaidAnimator.playback.compressRepeats": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.playback.compressRepeats%"
        },
        "mermaidAnimator.playback.altBranches": {
          "type": "string",
          "default": "first",
          "enum": [
            "first",
            "all",
            "ask"
          ],
          "markdownDescription": "%config.playback.altBranches%",
          "enumDescriptions": [
            "%config.playback.altBranches.first%",
            "%config.playback.altBranches.all%",
            "%config.playback.altBranches.ask%"
          ]
        },
        "mermaidAnimator.playback.parallel": {
          "type": "string",
          "default": "concurrent",
          "enum": [
            "concurrent",
            "sequential"
          ],
          "markdownDescription": "%config.playback.parallel%",
          "enumDescriptions": [
            "%config.playback.parallel.concurrent%",
            "%config.playback.parallel.sequential%"
          ]
        },
        "mermaidAnimator.display.showCaptions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.display.showCaptions%"
        },
        "mermaidAnimator.display.showInspector": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.display.showInspector%"
        },
        "mermaidAnimator.presentation.chapterCards": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.presentation.chapterCards%"
        },
        "mermaidAnimator.presentation.zenMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.presentation.zenMode%"
        },
        "mermaidAnimator.annotations.highlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.annotations.highlight%"
        },
        "mermaidAnimator.view.default": {
          "type": "string",
          "default": "sequence",
          "enum": [
            "sequence",
            "topology",
            "split"
          ],
          "markdownDescription": "%config.view.default%",
          "enumDescriptions": [
            "%config.view.default.sequence%",
            "%config.view.default.topology%",
            "%config.view.default.split%"
          ]
        },
        "mermaidAnimator.topology.layout": {
          "type": "string",
          "default": "layered",
          "enum": [
            "layered",
            "force",
            "manual"
          ],
          "markdownDescription": "%config.topology.layout%",
          "enumDescriptions": [
            "%config.topology.layout.layered%",
            "%config.topology.layout.force%",
            "%config.topology.layout.manual%"
          ]
        },
        "mermaidAnimator.topology.direction": {
          "type": "string",
          "default": "LR",
          "enum": [
            "LR",
            "TB"
          ],
          "markdownDescription": "%config.topology.direction%",
          "enumDescriptions": [
            "%config.topology.direction.LR%",
            "%config.topology.direction.TB%"
          ]
        },
        "mermaidAnimator.topology.edgeStyle": {
          "type": "string",
          "default": "curved",
          "enum": [
            "curved",
            "orthogonal",
            "straight"
          ],
          "markdownDescription": "%config.topology.edgeStyle%",
          "enumDescriptions": [
            "%config.topology.edgeStyle.curved%",
            "%config.topology.edgeStyle.orthogonal%",
            "%config.topology.edgeStyle.straight%"
          ]
        },
        "mermaidAnimator.topology.returnMessages": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "separate",
            "hide"
          ],
          "markdownDescription": "%config.topology.returnMessages%",
          "enumDescriptions": [
            "%config.topology.returnMessages.merge%",
            "%config.topology.returnMessages.separate%",
            "%config.topology.returnMessages.hide%"
          ]
        },
        "mermaidAnimator.topology.edgeWeight": {
          "type": "string",
          "default": "count",
          "enum": [
            "count",
            "uniform"
          ],
          "markdownDescription": "%config.topology.edgeWeight%",
          "enumDescriptions": [
            "%config.topology.edgeWeight.count%",
            "%config.topology.edgeWeight.uniform%"
          ]
        },
        "mermaidAnimator.display.showMinimap": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "markdownDescription": "%config.display.showMinimap%",
          "enumDescriptions": [
            "%config.display.showMinimap.auto%",
            "%config.display.showMinimap.always%",
            "%config.display.showMinimap.never%"
          ]
        },
        "mermaidAnimator.display.participantNames": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "off"
          ],
          "markdownDescription": "%config.display.participantNames%",
          "enumDescriptions": [
            "%config.display.participantNames.auto%",
            "%config.display.participantNames.off%"
          ]
        },
        "mermaidAnimator.display.arrowEndNames": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "auto",
            "always"
          ],
          "markdownDescription": "%config.display.arrowEndNames%",
          "enumDescriptions": [
            "%config.display.arrowEndNames.off%",
            "%config.display.arrowEndNames.auto%",
            "%config.display.arrowEndNames.always%"
          ]
        },
        "mermaidAnimator.export.defaultFormat": {
          "type": "string",
          "enum": [
            "gif",
            "webm",
            "mp4",
            "animatedSvg",
            "html",
            "svg",
            "png"
          ],
          "default": "animatedSvg",
          "markdownDescription": "%config.export.defaultFormat%",
          "enumDescriptions": [
            "%config.export.defaultFormat.gif%",
            "%config.export.defaultFormat.webm%",
            "%config.export.defaultFormat.mp4%",
            "%config.export.defaultFormat.animatedSvg%",
            "%config.export.defaultFormat.html%",
            "%config.export.defaultFormat.svg%",
            "%config.export.defaultFormat.png%"
          ]
        },
        "mermaidAnimator.export.fps": {
          "type": "number",
          "enum": [
            12,
            15,
            24,
            30,
            60
          ],
          "default": 30,
          "markdownDescription": "%config.export.fps%"
        },
        "mermaidAnimator.export.scale": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ],
          "default": 2,
          "markdownDescription": "%config.export.scale%"
        },
        "mermaidAnimator.export.background": {
          "type": "string",
          "default": "theme",
          "pattern": "^(theme|transparent|#[0-9a-fA-F]{6})$",
          "patternErrorMessage": "%config.export.background.error%",
          "markdownDescription": "%config.export.background%"
        },
        "mermaidAnimator.export.includeCaptions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.export.includeCaptions%"
        },
        "mermaidAnimator.export.outputDirectory": {
          "type": "string",
          "default": "${fileDirname}",
          "markdownDescription": "%config.export.outputDirectory%"
        },
        "mermaidAnimator.export.svgAdaptiveTheme": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.export.svgAdaptiveTheme%"
        },
        "mermaidAnimator.diagramsView.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagramsView.enabled%"
        },
        "mermaidAnimator.diagramsView.maxFiles": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "markdownDescription": "%config.diagramsView.maxFiles%"
        },
        "mermaidAnimator.files.include": {
          "type": "string",
          "default": "**/*.{md,mdx,mmd,mermaid}",
          "markdownDescription": "%config.files.include%"
        }
      }
    },
    "keybindings": [
      {
        "command": "mermaidAnimator.openToSide",
        "key": "ctrl+k alt+m",
        "mac": "cmd+k alt+m",
        "when": "editorTextFocus && mermaidAnimator.editorHasDiagram"
      },
      {
        "command": "mermaidAnimator.togglePlay",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "mermaidAnimator.panelActive"
      },
      {
        "command": "mermaidAnimator.nextStep",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "mermaidAnimator.panelActive"
      },
      {
        "command": "mermaidAnimator.previousStep",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "mermaidAnimator.panelActive"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mermaidAnimator.diagrams",
          "name": "%view.diagrams%",
          "when": "config.mermaidAnimator.diagramsView.enabled",
          "icon": "media/types/sequence-dark.svg",
          "contextualTitle": "Mermaid Animator"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mermaidAnimator.diagrams",
        "contents": "%view.diagrams.empty%"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openSample",
            "title": "%walkthrough.openSample.title%",
            "description": "%walkthrough.openSample.description%",
            "media": {
              "image": "media/walkthrough/open-sample.svg",
              "altText": "%walkthrough.openSample.alt%"
            },
            "completionEvents": [
              "onCommand:mermaidAnimator.walkthrough.openSample"
            ]
          },
          {
            "id": "stepThrough",
            "title": "%walkthrough.stepThrough.title%",
            "description": "%walkthrough.stepThrough.description%",
            "media": {
              "image": "media/walkthrough/step-through.svg",
              "altText": "%walkthrough.stepThrough.alt%"
            },
            "completionEvents": [
              "onCommand:mermaidAnimator.nextStep"
            ]
          },
          {
            "id": "switchViews",
            "title": "%walkthrough.switchViews.title%",
            "description": "%walkthrough.switchViews.description%",
            "media": {
              "image": "media/walkthrough/switch-views.svg",
              "altText": "%walkthrough.switchViews.alt%"
            },
            "completionEvents": [
              "onCommand:mermaidAnimator.setView.split"
            ]
          },
          {
            "id": "annotate",
            "title": "%walkthrough.annotate.title%",
            "description": "%walkthrough.annotate.description%",
            "media": {
              "image": "media/walkthrough/annotate.svg",
              "altText": "%walkthrough.annotate.alt%"
            },
            "completionEvents": [
              "onCommand:mermaidAnimator.walkthrough.annotate"
            ]
          },
          {
            "id": "export",
            "title": "%walkthrough.export.title%",
            "description": "%walkthrough.export.description%",
            "media": {
              "image": "media/walkthrough/export.svg",
              "altText": "%walkthrough.export.alt%"
            },
            "completionEvents": [
              "onCommand:mermaidAnimator.export"
            ]
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.animator.json",
        "url": "./schemas/animator.schema.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies --out ../../mermaid-animator.vsix"
  },
  "devDependencies": {
    "@mermaid-animator/core": "*",
    "@mermaid-animator/protocol": "*"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}

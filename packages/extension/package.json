{
  "name": "mermaid-animator",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "enbinario",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "sequence diagram",
    "animation",
    "diagram",
    "markdown"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121417",
    "theme": "dark"
  },
  "main": "./dist/extension.node.js",
  "browser": "./dist/extension.web.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onWebviewPanel:mermaidAnimator.panel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ]
      }
    ],
    "commands": [
      {
        "command": "mermaidAnimator.open",
        "title": "%command.open%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.openToSide",
        "title": "%command.openToSide%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.openAtCursor",
        "title": "%command.openAtCursor%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.animateAll",
        "title": "%command.animateAll%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.openFromExplorer",
        "title": "%command.openFromExplorer%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.openDiagram",
        "title": "%command.openDiagram%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export",
        "title": "%command.export%",
        "category": "Mermaid Animator",
        "icon": "$(export)"
      },
      {
        "command": "mermaidAnimator.exportDiagram",
        "title": "%command.exportDiagram%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.svg",
        "title": "%command.export.svg%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.export.png",
        "title": "%command.export.png%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.copyImage",
        "title": "%command.copyImage%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.togglePlay",
        "title": "%command.togglePlay%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.play",
        "title": "%command.play%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.pause",
        "title": "%command.pause%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.nextStep",
        "title": "%command.nextStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.previousStep",
        "title": "%command.previousStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.firstStep",
        "title": "%command.firstStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.lastStep",
        "title": "%command.lastStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.goToStep",
        "title": "%command.goToStep%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.revealSource",
        "title": "%command.revealSource%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.startPresentation",
        "title": "%command.startPresentation%",
        "category": "Mermaid Animator",
        "icon": "$(play-circle)"
      },
      {
        "command": "mermaidAnimator.stopPresentation",
        "title": "%command.stopPresentation%",
        "category": "Mermaid Animator",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mermaidAnimator.nextChapter",
        "title": "%command.nextChapter%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.previousChapter",
        "title": "%command.previousChapter%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.showTranscript",
        "title": "%command.showTranscript%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.toggleInspector",
        "title": "%command.toggleInspector%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.search",
        "title": "%command.search%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.insertAnnotation",
        "title": "%command.insertAnnotation%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.setView.sequence",
        "title": "%command.setView.sequence%",
        "category": "Mermaid Animator",
        "icon": "$(list-ordered)"
      },
      {
        "command": "mermaidAnimator.setView.topology",
        "title": "%command.setView.topology%",
        "category": "Mermaid Animator",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "mermaidAnimator.setView.split",
        "title": "%command.setView.split%",
        "category": "Mermaid Animator",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mermaidAnimator.toggleView",
        "title": "%command.toggleView%",
        "category": "Mermaid Animator"
      },
      {
        "command": "mermaidAnimator.resetLayout",
        "title": "%command.resetLayout%",
        "category": "Mermaid Animator"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mermaidAnimator.open",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openToSide",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openAtCursor",
          "when": "mermaidAnimator.cursorInDiagram"
        },
        {
          "command": "mermaidAnimator.animateAll",
          "when": "mermaidAnimator.editorHasDiagram"
        },
        {
          "command": "mermaidAnimator.openFromExplorer",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.openDiagram",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.exportDiagram",
          "when": "false"
        },
        {
          "command": "mermaidAnimator.export",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.export.svg",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.export.png",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.copyImage",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.togglePlay",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.play",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.pause",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.nextStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.previousStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.firstStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.lastStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.goToStep",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.revealSource",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.startPresentation",
          "when": "mermaidAnimator.panelActive && !mermaidAnimator.presenting"
        },
        {
          "command": "mermaidAnimator.stopPresentation",
          "when": "mermaidAnimator.presenting"
        },
        {
          "command": "mermaidAnimator.nextChapter",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.previousChapter",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.showTranscript",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.toggleInspector",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.search",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.insertAnnotation",
          "when": "mermaidAnimator.cursorInDiagram"
        },
        {
          "command": "mermaidAnimator.setView.sequence",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.setView.topology",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.setView.split",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.toggleView",
          "when": "mermaidAnimator.panelActive"
        },
        {
          "command": "mermaidAnimator.resetLayout",
          "when": "mermaidAnimator.panelActive"
        }
      ],
      "editor/title": [
        {
          "command": "mermaidAnimator.openToSide",
          "when": "mermaidAnimator.editorHasDiagram && !mermaidAnimator.panelActive",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidAnimator.openAtCursor",
          "when": "mermaidAnimator.cursorInDiagram",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "mermaidAnimator.openFromExplorer",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|mdx)$/i",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "Mermaid Animator",
      "properties": {
        "mermaidAnimator.theme.mode": {
          "type": "string",
          "enum": [
            "auto",
            "ivory",
            "graphite",
            "highContrast"
          ],
          "enumDescriptions": [
            "%config.theme.mode.auto%",
            "%config.theme.mode.ivory%",
            "%config.theme.mode.graphite%",
            "%config.theme.mode.highContrast%"
          ],
          "default": "auto",
          "markdownDescription": "%config.theme.mode%"
        },
        "mermaidAnimator.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.enabled%"
        },
        "mermaidAnimator.files.languages": {
          "type": "array",
          "default": [
            "markdown",
            "mdx",
            "mermaid"
          ],
          "markdownDescription": "%config.files.languages%",
          "items": {
            "type": "string"
          }
        },
        "mermaidAnimator.liveReload.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.liveReload.enabled%"
        },
        "mermaidAnimator.liveReload.debounceMs": {
          "type": "number",
          "default": 250,
          "markdownDescription": "%config.liveReload.debounceMs%",
          "minimum": 0,
          "maximum": 5000
        },
        "mermaidAnimator.sync.stepToEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.sync.stepToEditor%"
        },
        "mermaidAnimator.sync.cursorToStep": {
          "type": "string",
          "default": "click",
          "markdownDescription": "%config.sync.cursorToStep%",
          "enum": [
            "off",
            "click",
            "follow"
          ],
          "enumDescriptions": [
            "%config.sync.cursorToStep.off%",
            "%config.sync.cursorToStep.click%",
            "%config.sync.cursorToStep.follow%"
          ]
        },
        "mermaidAnimator.playback.autoplay": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.playback.autoplay%"
        },
        "mermaidAnimator.playback.speed": {
          "type": "number",
          "default": 1,
          "markdownDescription": "%config.playback.speed%",
          "minimum": 0.25,
          "maximum": 4
        },
        "mermaidAnimator.playback.dwell": {
          "type": "string",
          "default": "adaptive",
          "markdownDescription": "%config.playback.dwell%",
          "enum": [
            "adaptive",
            "fixed"
          ],
          "enumDescriptions": [
            "%config.playback.dwell.adaptive%",
            "%config.playback.dwell.fixed%"
          ]
        },
        "mermaidAnimator.playback.dwellMs": {
          "type": "number",
          "default": 900,
          "markdownDescription": "%config.playback.dwellMs%",
          "minimum": 0
        },
        "mermaidAnimator.playback.onEnd": {
          "type": "string",
          "default": "stop",
          "markdownDescription": "%config.playback.onEnd%",
          "enum": [
            "stop",
            "loop",
            "rewind"
          ],
          "enumDescriptions": [
            "%config.playback.onEnd.stop%",
            "%config.playback.onEnd.loop%",
            "%config.playback.onEnd.rewind%"
          ]
        },
        "mermaidAnimator.playback.reverse": {
          "type": "string",
          "default": "animate",
          "markdownDescription": "%config.playback.reverse%",
          "enum": [
            "animate",
            "cut"
          ],
          "enumDescriptions": [
            "%config.playback.reverse.animate%",
            "%config.playback.reverse.cut%"
          ]
        },
        "mermaidAnimator.playback.pauseOnHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.playback.pauseOnHover%"
        },
        "mermaidAnimator.playback.startAt": {
          "type": "string",
          "default": "beginning",
          "markdownDescription": "%config.playback.startAt%",
          "enum": [
            "beginning",
            "end"
          ],
          "enumDescriptions": [
            "%config.playback.startAt.beginning%",
            "%config.playback.startAt.end%"
          ]
        },
        "mermaidAnimator.playback.notes": {
          "type": "string",
          "default": "step",
          "markdownDescription": "%config.playback.notes%",
          "enum": [
            "step",
            "attach",
            "hidden"
          ],
          "enumDescriptions": [
            "%config.playback.notes.step%",
            "%config.playback.notes.attach%",
            "%config.playback.notes.hidden%"
          ]
        },
        "mermaidAnimator.scrubber.snap": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.scrubber.snap%"
        },
        "mermaidAnimator.display.futureSteps": {
          "type": "string",
          "default": "hidden",
          "markdownDescription": "%config.display.futureSteps%",
          "enum": [
            "hidden",
            "ghosted",
            "visible"
          ],
          "enumDescriptions": [
            "%config.display.futureSteps.hidden%",
            "%config.display.futureSteps.ghosted%",
            "%config.display.futureSteps.visible%"
          ]
        },
        "mermaidAnimator.display.pastSteps": {
          "type": "string",
          "default": "full",
          "markdownDescription": "%config.display.pastSteps%",
          "enum": [
            "full",
            "muted",
            "trail"
          ],
          "enumDescriptions": [
            "%config.display.pastSteps.full%",
            "%config.display.pastSteps.muted%",
            "%config.display.pastSteps.trail%"
          ]
        },
        "mermaidAnimator.display.trailLength": {
          "type": "integer",
          "default": 3,
          "markdownDescription": "%config.display.trailLength%",
          "minimum": 1,
          "maximum": 20
        },
        "mermaidAnimator.motion.profile": {
          "type": "string",
          "default": "formal",
          "markdownDescription": "%config.motion.profile%",
          "enum": [
            "formal",
            "expressive",
            "minimal",
            "none"
          ],
          "enumDescriptions": [
            "%config.motion.profile.formal%",
            "%config.motion.profile.expressive%",
            "%config.motion.profile.minimal%",
            "%config.motion.profile.none%"
          ]
        },
        "mermaidAnimator.motion.respectReducedMotion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.motion.respectReducedMotion%"
        },
        "mermaidAnimator.motion.travelIndicator": {
          "type": "string",
          "default": "pulse",
          "markdownDescription": "%config.motion.travelIndicator%",
          "enum": [
            "pulse",
            "comet",
            "none"
          ],
          "enumDescriptions": [
            "%config.motion.travelIndicator.pulse%",
            "%config.motion.travelIndicator.comet%",
            "%config.motion.travelIndicator.none%"
          ]
        },
        "mermaidAnimator.camera.mode": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "%config.camera.mode%",
          "enum": [
            "auto",
            "fit",
            "follow",
            "cinematic",
            "manual"
          ],
          "enumDescriptions": [
            "%config.camera.mode.auto%",
            "%config.camera.mode.fit%",
            "%config.camera.mode.follow%",
            "%config.camera.mode.cinematic%",
            "%config.camera.mode.manual%"
          ]
        },
        "mermaidAnimator.playback.loopIterations": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "%config.playback.loopIterations%"
        },
        "mermaidAnimator.playback.compressRepeats": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.playback.compressRepeats%"
        },
        "mermaidAnimator.playback.altBranches": {
          "type": "string",
          "default": "first",
          "enum": [
            "first",
            "all",
            "ask"
          ],
          "markdownDescription": "%config.playback.altBranches%",
          "enumDescriptions": [
            "%config.playback.altBranches.first%",
            "%config.playback.altBranches.all%",
            "%config.playback.altBranches.ask%"
          ]
        },
        "mermaidAnimator.playback.parallel": {
          "type": "string",
          "default": "concurrent",
          "enum": [
            "concurrent",
            "sequential"
          ],
          "markdownDescription": "%config.playback.parallel%",
          "enumDescriptions": [
            "%config.playback.parallel.concurrent%",
            "%config.playback.parallel.sequential%"
          ]
        },
        "mermaidAnimator.display.showCaptions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.display.showCaptions%"
        },
        "mermaidAnimator.display.showInspector": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.display.showInspector%"
        },
        "mermaidAnimator.presentation.chapterCards": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.presentation.chapterCards%"
        },
        "mermaidAnimator.presentation.zenMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.presentation.zenMode%"
        },
        "mermaidAnimator.annotations.highlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.annotations.highlight%"
        },
        "mermaidAnimator.view.default": {
          "type": "string",
          "default": "sequence",
          "enum": [
            "sequence",
            "topology",
            "split"
          ],
          "markdownDescription": "%config.view.default%",
          "enumDescriptions": [
            "%config.view.default.sequence%",
            "%config.view.default.topology%",
            "%config.view.default.split%"
          ]
        },
        "mermaidAnimator.topology.layout": {
          "type": "string",
          "default": "layered",
          "enum": [
            "layered",
            "force",
            "manual"
          ],
          "markdownDescription": "%config.topology.layout%",
          "enumDescriptions": [
            "%config.topology.layout.layered%",
            "%config.topology.layout.force%",
            "%config.topology.layout.manual%"
          ]
        },
        "mermaidAnimator.topology.direction": {
          "type": "string",
          "default": "LR",
          "enum": [
            "LR",
            "TB"
          ],
          "markdownDescription": "%config.topology.direction%",
          "enumDescriptions": [
            "%config.topology.direction.LR%",
            "%config.topology.direction.TB%"
          ]
        },
        "mermaidAnimator.topology.edgeStyle": {
          "type": "string",
          "default": "curved",
          "enum": [
            "curved",
            "orthogonal",
            "straight"
          ],
          "markdownDescription": "%config.topology.edgeStyle%",
          "enumDescriptions": [
            "%config.topology.edgeStyle.curved%",
            "%config.topology.edgeStyle.orthogonal%",
            "%config.topology.edgeStyle.straight%"
          ]
        },
        "mermaidAnimator.topology.returnMessages": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "separate",
            "hide"
          ],
          "markdownDescription": "%config.topology.returnMessages%",
          "enumDescriptions": [
            "%config.topology.returnMessages.merge%",
            "%config.topology.returnMessages.separate%",
            "%config.topology.returnMessages.hide%"
          ]
        },
        "mermaidAnimator.topology.edgeWeight": {
          "type": "string",
          "default": "count",
          "enum": [
            "count",
            "uniform"
          ],
          "markdownDescription": "%config.topology.edgeWeight%",
          "enumDescriptions": [
            "%config.topology.edgeWeight.count%",
            "%config.topology.edgeWeight.uniform%"
          ]
        },
        "mermaidAnimator.display.showMinimap": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "markdownDescription": "%config.display.showMinimap%",
          "enumDescriptions": [
            "%config.display.showMinimap.auto%",
            "%config.display.showMinimap.always%",
            "%config.display.showMinimap.never%"
          ]
        }
      }
    },
    "keybindings": [
      {
        "command": "mermaidAnimator.openToSide",
        "key": "ctrl+k alt+m",
        "mac": "cmd+k alt+m",
        "when": "editorTextFocus && mermaidAnimator.editorHasDiagram"
      },
      {
        "command": "mermaidAnimator.togglePlay",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "mermaidAnimator.panelActive"
      },
      {
        "command": "mermaidAnimator.nextStep",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "mermaidAnimator.panelActive"
      },
      {
        "command": "mermaidAnimator.previousStep",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "mermaidAnimator.panelActive"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies --out ../../mermaid-animator.vsix"
  },
  "devDependencies": {
    "@mermaid-animator/core": "*",
    "@mermaid-animator/protocol": "*"
  }
}
